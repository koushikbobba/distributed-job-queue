      "type": "stat",
      "targets": [
        {
          "expr": "sum(job_queue_idempotency_cache_hits_total)",
          "legendFormat": "Cache Hits",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "title": "Job Throughput by Status (Jobs/min)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (status) (rate(job_queue_jobs_total[1m])) * 60",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "title": "95th Percentile Execution Duration (seconds)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, job_type) (rate(job_queue_execution_duration_seconds_bucket[5m])))",
          "legendFormat": "{{job_type}} (p95)",
          "refId": "A"
        }
      ]
